#!/bin/bash
set -e

APP_DIR="/opt/meeting-recorder"
VENV_DIR="$APP_DIR/venv"
LOG_DIR="/var/log/meeting-recorder"
APT_REPO="https://dipakmdhrm.github.io/meeting-recorder"
KEYRING="/etc/apt/keyrings/meeting-recorder.gpg"
SOURCES="/etc/apt/sources.list.d/meeting-recorder.list"

# Stop a daemon left over from the previous version. dpkg has already replaced
# the files underneath it, but the process keeps serving the old code it loaded
# at startup — and the window is a thin client of that daemon over D-Bus, so a
# freshly launched window still renders the old UI. Without this an upgrade
# silently does nothing until the user finds and kills the daemon by hand.
#
# This lives in postinst rather than prerm because prerm comes from the version
# being replaced: fixing it there only helps the upgrade after next.
#
# SIGTERM is handled — an in-progress recording is stopped with its audio kept,
# and the window follows the daemon out because it watches the Engine bus name.
# Nothing is restarted here: the tray autostart entry, the launcher and the CLI
# each spawn a daemon on demand.
pkill -TERM -f 'meeting-recorder(-daemon|-window|-process|-install)?$' 2>/dev/null || true

# Create Python virtual environment and install dependencies
python3 -m venv "$VENV_DIR" --system-site-packages
"$VENV_DIR/bin/pip" install --quiet --upgrade pip
# Prefer the pinned lock file when the package ships one (reproducible
# installs); fall back to the loose requirements otherwise.
if [ -f "$APP_DIR/requirements.lock" ]; then
    "$VENV_DIR/bin/pip" install --quiet -r "$APP_DIR/requirements.lock"
else
    "$VENV_DIR/bin/pip" install --quiet -r "$APP_DIR/requirements.txt"
fi

# Create system log directory, world-writable so any user can write logs
mkdir -p "$LOG_DIR"
chmod 1777 "$LOG_DIR"

# Configure apt repository on fresh installs only (persists across upgrades)
if [ -z "$2" ]; then
    mkdir -p /etc/apt/keyrings
    curl -fsSL "${APT_REPO}/key.gpg" | gpg --dearmor -o "$KEYRING"
    echo "deb [arch=amd64,arm64 signed-by=${KEYRING}] ${APT_REPO} stable main" > "$SOURCES"
    apt-get update -qq 2>/dev/null || true
fi

# Update desktop database and icon cache
update-desktop-database /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
